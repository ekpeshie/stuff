# Copy to .env (never commit .env). Read by the server only; nothing here reaches the browser.

# Which product provider to use: "feed", or leave empty / "sample" for labelled sample products.
PRODUCT_PROVIDER=

# --- PRODUCT_PROVIDER=feed: an authorized product feed (retailer or affiliate network) ---
# https URL or local path to a CSV/TSV/JSON feed (gzip is fine). Network feed URLs often
# embed your API key, so treat this as a secret.
FEED_URL=
# Optional request header for feeds that need one, e.g. "Authorization: Bearer <token>".
FEED_AUTH_HEADER=
# auto (default), csv or json
FEED_FORMAT=auto
# Name shown in the UI for this source.
FEED_LABEL=
# Retailer name for single-retailer feeds that don't name the merchant per row.
FEED_RETAILER_NAME=
# "direct" shows the feed's image URLs. Set it ONLY if the feed's terms allow displaying
# them (most affiliate feeds supply images for publishers to show). Anything else hides images.
FEED_IMAGE_POLICY=
# How often to re-download the feed (conditional request), in minutes. Match the provider's
# update schedule and terms; don't poll more often than they allow.
FEED_REFRESH_MINUTES=360
# Prices/availability older than this are not shown as current ("Check price at retailer").
FEED_PRICE_MAX_AGE_MINUTES=1440
# Extra column names to try per field, as JSON, e.g. {"brand":["designer"],"link":["click_url"]}
FEED_COLUMN_MAP=

# Port for `npm start`
PORT=8787
